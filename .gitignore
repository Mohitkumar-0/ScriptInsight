# Python environments and caches
.venv*/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Temporary uploads are never kept
uploads/*
!uploads/.gitkeep

# Datasets are obtained separately (see docs/DATASET.md)
/data/
/datasets/

# Large binary model weights (>100 MB) are kept out of git; see README "Model artifacts"
*.h5
models/**/*.joblib
models/**/*.pt
artifacts/features/

# Split manifest of the Kaggle demo data: absolute local paths and file names that contain people's names
artifacts/splits/manifest.csv

# OS / editor
.DS_Store
._*
Thumbs.db
node_modules/

# Local diagnostic output (scripts/phase2_baseline.ps1)
phase2_*.txt

# HiEnWrite smoke-test outputs and checkpoint candidates
artifacts/hienwrite/smoke/
artifacts/hienwrite/runs/
